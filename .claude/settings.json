            "command": "bash \"${CLAUDE_PROJECT_DIR:-$PWD}/.claude/hooks/UserPromptSubmit/checkpoint-reminder.sh\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
